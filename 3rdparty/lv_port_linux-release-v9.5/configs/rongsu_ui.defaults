LV_COLOR_DEPTH 32

LV_DEF_REFR_PERIOD 16

LV_USE_LINUX_DRM 1
LV_LINUX_DRM_USE_EGL 1
LV_USE_LINUX_DRM_GBM_BUFFERS 1

LV_USE_LINUX_FBDEV 0
LV_USE_SDL 0
LV_USE_WAYLAND 0
LV_USE_X11 0
LV_USE_GLFW 0

LV_USE_EVDEV 1
LV_USE_LIBINPUT 0

LV_BUILD_EXAMPLES 0
LV_BUILD_DEMOS 0

LV_USE_LOG 1
LV_LOG_LEVEL LV_LOG_LEVEL_WARN
LV_LOG_PRINTF 1

LV_FONT_MONTSERRAT_12 1
LV_FONT_MONTSERRAT_14 1
LV_FONT_MONTSERRAT_16 1
LV_FONT_MONTSERRAT_18 1
LV_FONT_MONTSERRAT_20 1
# 22 是浅色档弹窗页脚按钮文字的稿值（font_user_dlg_btn，1280 档）
LV_FONT_MONTSERRAT_22 1
LV_FONT_MONTSERRAT_24 1
LV_FONT_MONTSERRAT_28 1
LV_FONT_MONTSERRAT_32 1
LV_FONT_MONTSERRAT_36 1
# 40 是浅色稿 HOME 卡分级大字的稿值（font_user_display，1280 档）
LV_FONT_MONTSERRAT_40 1
LV_FONT_MONTSERRAT_48 1
LV_FONT_DEFAULT &lv_font_montserrat_32

# TinyTTF：调试测试页用中文子集 TTF（嵌入数据，运行时渲染），不需文件系统
LV_USE_TINY_TTF 1
LV_TINY_TTF_FILE_SUPPORT 0

LV_USE_STDLIB_MALLOC LV_STDLIB_CLIB
LV_USE_STDLIB_STRING LV_STDLIB_CLIB
LV_USE_STDLIB_SPRINTF LV_STDLIB_CLIB

LV_USE_3DTEXTURE 0
LV_USE_GLTF 0
LV_USE_OPENGLES 1
LV_USE_DEMO_GLTF 0

LV_USE_VECTOR_GRAPHIC 0
LV_USE_THORVG_INTERNAL 0
LV_USE_LOTTIE 0
LV_USE_FLOAT 1
LV_USE_MATRIX 1
LV_USE_SYSMON 0
LV_USE_PERF_MONITOR 0

# TJPGD：打印历史缩略图 JPEG 解码（baseline JPEG）
LV_USE_TJPGD 1

# 延时摄影序列帧 PNG 解码（lv_image_set_src("A:/.../*.png")）
LV_USE_LODEPNG 1

# POSIX 文件系统驱动：按路径加载 /data/media/video 下缩略图（盘符 'A'，如 "A:/data/media/video/x.rthm"）
LV_USE_FS_POSIX 1
LV_FS_POSIX_LETTER 'A'

# 图片缓存：必须显式给值，模板默认是 0（= 关闭）。
#
# 上面开了 FS_POSIX + LODEPNG + TJPGD，也就是允许 lv_image_set_src(img, "A:/...")
# 直接以文件路径为源。缓存为 0 时，这类 lv_image 在 lv_timer_handler 的**每一次
# 重绘**里都会重新读文件、重新解码——列表滚动、延时摄影播放期间会持续发生。
# 实测（ui_perf_probe 的 uiloop 探针，16023 个 5 秒样本）：32% 的窗口里
# lv_timer_handler 单次超过 100ms，最大 1.53s，4732 个窗口主循环掉到 10Hz 以下。
#
# 8MB 按本机余量给：mem_avail 常态 3.6GB，rongsu_ui RSS 约 82MB，压力可忽略。
# HEADER_CACHE 单独计数，命中后可省掉「只为读宽高」而打开并解析文件头的开销。
LV_CACHE_DEF_SIZE (8 * 1024 * 1024)
LV_IMAGE_HEADER_CACHE_DEF_CNT 32

LV_DRAW_LAYER_SIMPLE_BUF_SIZE (256 * 1024)
LV_OBJ_STYLE_CACHE 1

LV_DRAW_SW_COMPLEX 1
LV_USE_DRAW_SW_COMPLEX_GRADIENTS 1