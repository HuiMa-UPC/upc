# Topic logs under /var/log/topic
# Driven by /etc/init.d/S02logrotate (this rootfs has no cron).
#
# Most rongsu topic writers fopen/fclose per line and hold no long-lived fd,
# so rename + nocreate is enough: the next write recreates the file.
#
# Do not glob /var/log/topic/*.log - that would also match
# topic_boot_lifecycle.log, which must use copytruncate below, and
# logrotate rejects a file matched by two stanzas.
#
# Add one glob line when introducing a new topic category.
#
# Keep LF line endings: logrotate rejects every stanza in a CRLF file.

/var/log/topic/topic_camera_*.log
/var/log/topic/topic_device_*.log
/var/log/topic/topic_ipc_*.log
/var/log/topic/topic_laser_*.log
/var/log/topic/topic_media_*.log
/var/log/topic/topic_misc.log
/var/log/topic/topic_mqtt_*.log
/var/log/topic/topic_msgbus_*.log
/var/log/topic/topic_print_*.log
/var/log/topic/topic_serial_*.log
/var/log/topic/topic_storage_*.log
/var/log/topic/topic_system_*.log
/var/log/topic/topic_tcp_*.log
/var/log/topic/topic_ui_*.log
/var/log/topic/topic_visual_*.log
/var/log/topic/topic_xfr_*.log
{
	size 4M
	rotate 3
	nocreate
	missingok
	notifempty
}

# STDOUT/STDERR are dup2()'d onto this file and no process handles SIGHUP.
/var/log/topic/topic_boot_lifecycle.log {
	size 4M
	rotate 3
	copytruncate
	missingok
	notifempty
}
